    "\n",
    "# Calculate improvement\n",
    "if mem0_avg_f1 > 0:\n",
    "    improvement = ((memlayer_avg_f1 - mem0_avg_f1) / mem0_avg_f1) * 100\n",
    "    print(f\"F1 Improvement: {improvement:+.1f}%\")\n",
    "    \n",
    "    if improvement > 0:\n",
    "        print(f\"\\n✅ SUCCESS! Memlayer BEATS Mem0 by {improvement:.1f}%! 🎉\")\n",
