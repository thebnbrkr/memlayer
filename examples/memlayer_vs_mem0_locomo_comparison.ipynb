    "\n",
    "metrics = ['F1', 'Exact Match', 'ROUGE-1']\n",
    "colors = ['#2E86AB', '#A23B72']\n",
    "\n",
    "for idx, (ax, metric) in enumerate(zip(axes, metrics)):\n",
