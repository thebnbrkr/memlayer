   "cell_type": "markdown",
   "metadata": {
    "id": "metrics"
   },
   "source": [
    "## 📏 Evaluation Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "define_metrics"
   },
   "outputs": [],
   "source": [
    "from rouge_score import rouge_scorer\n",
    "import numpy as np\n",
    "import re\n",
    "\n",
    "def normalize_answer(answer):\n",
    "    \"\"\"Normalize answer for comparison. Handles strings and numbers.\"\"\"\n",
    "    if answer is None:\n",
    "        return \"\"\n",
    "    \n",
    "    # Convert to string if not already\n",
    "    if not isinstance(answer, str):\n",
    "        answer = str(answer)\n",
    "    \n",
    "    # Remove articles\n",
    "    answer = re.sub(r'\\b(a|an|the)\\b', ' ', answer.lower())\n",
    "    \n",
    "    # Remove punctuation\n",
    "    answer = re.sub(r'[^\\w\\s]', ' ', answer)\n",
    "    \n",
    "    # Remove extra whitespace\n",
    "    answer = ' '.join(answer.split())\n",
    "    \n",
    "    return answer\n",
    "\n",
    "def calculate_f1(prediction, ground_truth) -> float:\n",
    "    \"\"\"Calculate F1 score (token overlap). Handles strings AND numbers.\"\"\"\n",
    "    pred_tokens = set(normalize_answer(prediction).split())\n",
    "    truth_tokens = set(normalize_answer(ground_truth).split())\n",
    "    \n",
    "    if len(pred_tokens) == 0 or len(truth_tokens) == 0:\n",
    "        return 0.0 if len(truth_tokens) > 0 else 1.0\n",
    "    \n",
    "    common = pred_tokens & truth_tokens\n",
    "    precision = len(common) / len(pred_tokens)\n",
    "    recall = len(common) / len(truth_tokens)\n",
    "    \n",
    "    if precision + recall == 0:\n",
    "        return 0.0\n",
    "    \n",
    "    f1 = 2 * (precision * recall) / (precision + recall)\n",
    "    return f1\n",
    "\n",
    "def calculate_rouge(prediction, ground_truth) -> dict:\n",
    "    \"\"\"Calculate ROUGE scores. Handles strings AND numbers.\"\"\"\n",
    "    pred_str = str(prediction).lower()\n",
    "    truth_str = str(ground_truth).lower()\n",
    "    \n",
    "    scorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2', 'rougeL'], use_stemmer=True)\n",
    "    scores = scorer.score(truth_str, pred_str)\n",
    "    \n",
    "    return {\n",
    "        'rouge1': scores['rouge1'].fmeasure,\n",
    "        'rouge2': scores['rouge2'].fmeasure,\n",
    "        'rougeL': scores['rougeL'].fmeasure\n",
    "    }\n",
    "\n",
    "def evaluate_qa(prediction, ground_truth) -> dict:\n",
    "    \"\"\"Comprehensive evaluation of a single QA pair.\"\"\"\n",
    "    f1 = calculate_f1(prediction, ground_truth)\n",
    "    rouge = calculate_rouge(prediction, ground_truth)\n",
    "    \n",
    "    # Exact match (for numeric answers)\n",
    "    exact_match = 1.0 if normalize_answer(prediction) == normalize_answer(ground_truth) else 0.0\n",
    "    \n",
    "    return {\n",
    "        'f1': f1,\n",
    "        'rouge1': rouge['rouge1'],\n",
    "        'rouge2': rouge['rouge2'],\n",
    "        'rougeL': rouge['rougeL'],\n",
    "        'exact_match': exact_match\n",
    "    }\n",
    "\n",
    "print(\"✅ Evaluation metrics defined (F1, ROUGE-1/2/L, Exact Match)\")\n",
    "print(\"   Handles both string and numeric answers correctly\")"
   ]
  },
