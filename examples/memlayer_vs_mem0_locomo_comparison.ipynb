    "        \n",
    "        # Store conversation turns\n",
    "        print(f\"   Storing conversation...\")\n",
    "        turn_count = 0\n",
    "        for turn in conversation['turns']:\n",
    "            try:\n",
    "                # Format as dialogue for storage\n",
    "                message = f\"{turn['speaker']}: {turn['text']}\"\n",
