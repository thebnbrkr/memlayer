    "## 🧪 Test 2: Mem0 (Vector-Search Baseline)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "test_mem0"
   },
   "outputs": [],
   "source": [
    "print(\"=\"*70)\n",
    "print(\"🧪 TEST 2: MEM0 (VECTOR-SEARCH BASELINE)\")\n",
    "print(\"=\"*70 + \"\\n\")\n",
    "\n",
    "try:\n",
    "    from mem0 import Memory\n",
    "    \n",
    "    # Initialize Mem0 with default config\n",
    "    mem0_config = {\n",
    "        \"vector_store\": {\n",
    "            \"provider\": \"chroma\",\n",
    "            \"config\": {\n",
    "                \"collection_name\": \"mem0_locomo_benchmark\",\n",
    "                \"path\": \"./mem0_benchmark_storage\"\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    mem0_client = Memory.from_config(mem0_config)\n",
    "    \n",
    "    mem0_results = []\n",
    "    mem0_errors = []\n",
    "    \n",
    "    test_conversations = conversations[:2]  # Same subset as Memlayer\n",
    "    print(f\"Testing on {len(test_conversations)} conversations\\n\")\n",
    "    \n",
    "    for conv_idx, conversation in enumerate(test_conversations):\n",
    "        conv_id = conversation['conversation_id']\n",
    "        user_id = f\"user_{conv_id}\"\n",
    "        \n",
    "        print(f\"\\n📍 Conversation {conv_idx + 1}/{len(test_conversations)} ({conv_id})\")\n",
    "        print(f\"   Speakers: {conversation['speaker_a']} & {conversation['speaker_b']}\")\n",
    "        print(f\"   Sessions: {conversation['num_sessions']}, Turns: {conversation['num_turns']}\")\n",
    "        \n",
    "        # Store conversation turns\n",
    "        print(f\"   Storing conversation...\")\n",
    "        turn_count = 0\n",
    "        for turn in conversation['turns']:\n",
    "            try:\n",
    "                message = f\"{turn['speaker']}: {turn['text']}\"\n",
    "                mem0_client.add(message, user_id=user_id)\n",
    "                turn_count += 1\n",
    "            except Exception as e:\n",
    "                mem0_errors.append(f\"Turn storage error: {str(e)[:100]}\")\n",
    "        \n",
    "        print(f\"   ✅ Stored {turn_count} turns\")\n",
    "        \n",
    "        # Query for QA pairs\n",
    "        qa_count = 0\n",
    "        for qa_idx, qa in enumerate(conversation['qa_pairs'][:10]):  # First 10 QA per conversation\n",
    "            try:\n",
    "                question = qa['question']\n",
    "                ground_truth = qa['answer']\n",
    "                category = qa['category_name']\n",
    "                \n",
    "                # Search Mem0\n",
    "                search_results = mem0_client.search(question, user_id=user_id, limit=5)\n",
    "                \n",
    "                # Extract response from search results\n",
    "                if search_results:\n",
    "                    if isinstance(search_results, dict) and 'results' in search_results:\n",
    "                        response = \" \".join([r.get('memory', str(r)) for r in search_results['results'][:3]])\n",
    "                    elif isinstance(search_results, list):\n",
    "                        response = \" \".join([r.get('memory', str(r)) if isinstance(r, dict) else str(r) for r in search_results[:3]])\n",
    "                    else:\n",
    "                        response = str(search_results)[:500]\n",
    "                else:\n",
    "                    response = \"No information found\"\n",
    "                \n",
    "                # Evaluate\n",
    "                metrics = evaluate_qa(response, ground_truth)\n",
    "                mem0_results.append({\n",
    "                    'conversation_id': conv_id,\n",
    "                    'category': category,\n",
    "                    'question': question,\n",
    "                    'predicted': response[:200],  # Truncate for storage\n",
    "                    'ground_truth': ground_truth,\n",
    "                    **metrics\n",
    "                })\n",
    "                qa_count += 1\n",
    "                \n",
