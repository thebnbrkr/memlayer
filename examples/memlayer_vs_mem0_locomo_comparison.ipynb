   "cell_type": "markdown",
   "metadata": {
    "id": "load_data"
   },
   "source": [
    "## 📥 Load LoCoMo Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "load_locomo"
   },
   "outputs": [],
   "source": [
    "import json\n",
    "import requests\n",
    "from typing import List, Dict, Any\n",
    "\n",
    "def load_locomo_from_github():\n",
    "    \"\"\"Load locomo10.json from official GitHub repo.\"\"\"\n",
    "    url = \"https://raw.githubusercontent.com/snap-research/locomo/refs/heads/main/data/locomo10.json\"\n",
    "    try:\n",
    "        print(\"📥 Downloading locomo10.json from GitHub...\\n\")\n",
    "        response = requests.get(url, timeout=30)\n",
    "        response.raise_for_status()\n",
    "        data = response.json()\n",
    "        print(f\"✅ Downloaded {len(data)} conversations\\n\")\n",
    "        return data\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️  Error downloading: {e}\")\n",
    "        return None\n",
    "\n",
    "def convert_locomo_to_benchmark(locomo_data: List[Dict]) -> List[Dict]:\n",
    "    \"\"\"\n",
    "    Convert official LoCoMo format to benchmark format.\n",
    "    \n",
    "    LoCoMo structure:\n",
    "    - conversation.speaker_a, speaker_b\n",
    "    - conversation.session_1, session_2, ...\n",
    "    - Each session has dialogue turns with speaker, dia_id, text, (optional) img_url, blip_caption, query\n",
    "    - qa: list of {question, answer, evidence, category}\n",
    "    \"\"\"\n",
    "    converted = []\n",
    "    \n",
    "    for item in locomo_data:\n",
    "        conv = item.get('conversation', {})\n",
    "        sample_id = item.get('sample_id', 'unknown')\n",
    "        \n",
    "        # Extract all dialogue turns from all sessions\n",
    "        all_turns = []\n",
    "        session_count = 0\n",
    "        \n",
    "        # Find all sessions\n",
    "        session_keys = sorted([k for k in conv.keys() if k.startswith('session_') and '_date_time' not in k])\n",
    "        \n",
    "        for session_key in session_keys:\n",
    "            session_data = conv.get(session_key, [])\n",
    "            session_num = int(session_key.split('_')[1])\n",
    "            datetime_key = f\"session_{session_num}_date_time\"\n",
    "            session_datetime = conv.get(datetime_key, \"unknown date\")\n",
    "            \n",
    "            for turn in session_data:\n",
    "                all_turns.append({\n",
    "                    'speaker': turn.get('speaker', ''),\n",
    "                    'text': turn.get('text', ''),\n",
    "                    'dia_id': turn.get('dia_id', f\"{session_num}:?\"),\n",
    "                    'session': session_num,\n",
    "                    'session_datetime': session_datetime,\n",
    "                    'img_url': turn.get('img_url'),\n",
    "                    'blip_caption': turn.get('blip_caption'),\n",
    "                })\n",
    "            session_count = session_num\n",
    "        \n",
    "        # Extract QA pairs\n",
    "        qa_pairs = []\n",
    "        for qa in item.get('qa', []):\n",
    "            qa_pairs.append({\n",
    "                'question': qa.get('question', ''),\n",
    "                'answer': qa.get('answer', ''),\n",
    "                'evidence': qa.get('evidence', []),\n",
    "                'category': qa.get('category', 0),\n",
    "                'category_name': {\n",
    "                    1: 'Single-hop',\n",
    "                    2: 'Multi-hop',\n",
    "                    3: 'Temporal Reasoning',\n",
    "                    4: 'Open-domain Knowledge',\n",
    "                    5: 'Adversarial'\n",
    "                }.get(qa.get('category', 0), 'Unknown')\n",
    "            })\n",
    "        \n",
    "        converted.append({\n",
    "            'conversation_id': sample_id,\n",
    "            'speaker_a': conv.get('speaker_a', 'Speaker A'),\n",
    "            'speaker_b': conv.get('speaker_b', 'Speaker B'),\n",
    "            'turns': all_turns,\n",
    "            'qa_pairs': qa_pairs,\n",
    "            'num_sessions': session_count,\n",
    "            'num_turns': len(all_turns),\n",
    "            'num_qa': len(qa_pairs),\n",
    "            'event_summary': item.get('event_summary', {}),\n",
    "            'observation': item.get('observation', {}),\n",
    "            'session_summary': item.get('session_summary', {})\n",
    "        })\n",
    "    \n",
    "    return converted\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"📊 LOADING LOCOMO DATASET\")\n",
    "print(\"=\"*70 + \"\\n\")\n",
    "\n",
    "locomo_raw = load_locomo_from_github()\n",
    "\n",
    "if locomo_raw:\n",
    "    conversations = convert_locomo_to_benchmark(locomo_raw)\n",
    "    print(f\"✅ Converted {len(conversations)} conversations\")\n    "\n",
    "    total_qa = sum(c['num_qa'] for c in conversations)\n",
    "    total_turns = sum(c['num_turns'] for c in conversations)\n",
    "    print(f\"\\n📈 Dataset Statistics:\")\n",
    "    print(f\"   - Conversations: {len(conversations)}\")\n",
    "    print(f\"   - Total QA pairs: {total_qa}\")\n",
    "    print(f\"   - Total turns: {total_turns}\")\n",
    "    print(f\"   - Avg turns per conversation: {total_turns // len(conversations)}\")\n",
    "    print(f\"   - Avg QA pairs per conversation: {total_qa // len(conversations)}\")\n",
    "else:\n",
    "    print(\"❌ Failed to load dataset\")\n",
    "    conversations = []\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)"
   ]
  },
