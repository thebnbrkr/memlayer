    "    \n",
    "    ax.set_ylabel(metric, fontsize=12, fontweight='bold')\n",
    "    ax.set_ylim(0, max(values) * 1.2)\n",
    "    ax.set_title(metric, fontsize=12, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('memlayer_vs_mem0_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n📈 Chart saved as 'memlayer_vs_mem0_comparison.png'\")"
