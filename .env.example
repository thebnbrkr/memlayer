# Memlayer Configuration
# =======================
# Copy this file to .env and configure for your environment

# ============================================================================
# API Keys (for examples and self-hosted deployment)
# ============================================================================

# OpenAI (Required for operation_mode=online)
OPENAI_API_KEY=

# Anthropic Claude (Optional - for future Claude integration)
ANTHROPIC_API_KEY=

# Google Gemini (Optional)
GOOGLE_API_KEY=

# Ollama (Optional - for local LLM)
OLLAMA_HOST=http://localhost:11434


# ============================================================================
# Self-Hosted Deployment Configuration (for Docker)
# ============================================================================

# PostgreSQL Database
POSTGRES_PASSWORD=changeMe123!
DATABASE_URL=postgresql://memlayer:${POSTGRES_PASSWORD}@postgres:5432/memlayer

# Storage Configuration
STORAGE_PATH=/app/data

# Operation Mode: online, local, or lightweight
OPERATION_MODE=online

# Rate Limiting (format: <number>/<unit>)
RATE_LIMIT=100/hour

# Debug Mode
DEBUG_MODE=false

# CORS Origins (comma-separated)
CORS_ORIGINS=*


# ============================================================================
# Development/Testing Configuration
# ============================================================================

# For running examples locally (not Docker)
MEMLAYER_STORAGE_PATH=./memlayer_data
MEMLAYER_USER_ID=demo_user


# ============================================================================
# Optional: Production Backends
# ============================================================================

# Memgraph (Graph Database) - uncomment to use
# MEMGRAPH_URI=bolt://memgraph:7687
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=

# Qdrant (Vector Database) - uncomment to use
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Pinecone - uncomment to use
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=us-west1-gcp
# PINECONE_INDEX=memlayer

# Zilliz - uncomment to use
# ZILLIZ_URI=
# ZILLIZ_TOKEN=
